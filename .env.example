# Copy to .env and fill in. NEVER commit .env.

# Adzuna (developer.adzuna.com)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Reed (reed.co.uk developer API; key used as HTTP Basic username, empty password)
REED_API_KEY=

# Anthropic (LLM scoring). Without it the pipeline uses a
# clearly-labelled heuristic scorer so runs still complete.
ANTHROPIC_API_KEY=

# Google Sheets: EITHER a path to the service-account JSON file...
GOOGLE_SERVICE_ACCOUNT_FILE=
# ...OR the full JSON blob (used in GitHub Actions).
GOOGLE_SERVICE_ACCOUNT_JSON=
# The spreadsheet ID (from the sheet URL). Empty = local dry-run xlsx preview.
SHEET_ID=

# Digest email (Resend preferred; SMTP fallback). Empty = digest written to out/digest.html only.
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
DIGEST_FROM=jobbank@resend.dev
DIGEST_TO=
DASHBOARD_URL=
